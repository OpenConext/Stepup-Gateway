#!/usr/bin/env bash

# Exit on error
set -e

# Change directory to the root dir
cd $(dirname $0)/../../

# Clear cache for functional environment
php ./bin/console cache:clear --env=functional

# Remove log
if [[ -f ./var/log/functional.log  ]]; then
  echo "Removing ./var/log/functional.log"
  rm ./var/log/functional.log
fi

# Only request code coverage when a coverage driver is active (e.g. XDEBUG_MODE=coverage).
# Requesting a coverage report without a driver makes PHPUnit warn and exit non-zero
# with "XDEBUG_MODE=coverage ... has to be set"

coverage_args=()
if [[ "${XDEBUG_MODE:-}" == *coverage* ]]; then
  echo "Generating code coverage in var/coverage/functional"
  mkdir -p var/coverage/functional
  coverage_args=(
    --coverage-php var/coverage/functional/phpunit.cov
    --coverage-clover var/coverage/functional/clover.xml
    --coverage-text
    --only-summary-for-coverage-text
  )
else
  echo "Note: Run with 'XDEBUG_MODE=coverage' to generate code coverage"
fi

# Run functional tests
./vendor/bin/phpunit -c ci/qa/phpunit-functional.xml "${coverage_args[@]}"
