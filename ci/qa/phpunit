#!/usr/bin/env bash

cd $(dirname $0)/../../

# PHPUnit Bridge should always be used in Symfony applications. (https://symfony.com/doc/current/components/phpunit_bridge.html)
# This will create a phpunit executable in /bin/ instead of /vendor/bin/
php ./bin/console cache:clear --env=test

# Only request code coverage when a coverage driver is active (e.g. XDEBUG_MODE=coverage).
# Requesting a coverage report without a driver makes PHPUnit warn and exit non-zero
# with "XDEBUG_MODE=coverage ... has to be set"

coverage_args=()
if [[ "${XDEBUG_MODE:-}" == *coverage* ]]; then
    echo "Generating code coverage in var/coverage/unit"
    mkdir -p var/coverage/unit
    coverage_args=(
        --coverage-php var/coverage/unit/phpunit.cov
        --coverage-clover var/coverage/unit/clover.xml
        --coverage-text
        --only-summary-for-coverage-text
    )
else
    echo "Note: Run with 'XDEBUG_MODE=coverage' to generate code coverage"
fi

# Run unit tests
./vendor/bin/phpunit -c ci/qa/phpunit.xml "${coverage_args[@]}"
